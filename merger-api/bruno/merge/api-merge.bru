meta {
  name: /api/merge
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/merge
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  files: @file({{fixturesPath}}\Doc1.pdf) @contentType(File)
  files: @file({{fixturesPath}}\Doc2.pdf) @contentType(File)
  files: @file({{fixturesPath}}\Doc3.pdf) @contentType(File)
}

settings {
  encodeUrl: true
  timeout: 0
}
